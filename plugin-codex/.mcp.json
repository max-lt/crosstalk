{
  "mcpServers": {
    "crosstalk": {
      "command": "/bin/sh",
      "args": [
        "./scripts/run.sh",
        "mcp",
        "--attach"
      ],
      "cwd": ".",
      "env_vars": [
        "PATH",
        "HOME",
        "CROSSTALK_BIN",
        "CROSSTALK_HOME",
        "CROSSTALK_CODEX_CONFIG"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 65
    }
  }
}
