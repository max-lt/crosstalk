{
  "mcpServers": {
    "crosstalk": {
      "command": "crosstalk",
      "args": [
        "mcp",
        "--attach"
      ],
      "env_vars": [
        "PATH",
        "HOME",
        "CROSSTALK_HOME",
        "CROSSTALK_CODEX_CONFIG"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 65
    }
  }
}
